@model IEnumerable<HotelDb.Models.Room>

@{
    ViewData["Title"] = "Home";
}

<div class="container">

    <!-- Our Rooms -->
    <section class="mb-4">
        <h3 class="fw-bold text-center mb-3" style="font-family: 'Playfair Display', serif;">Our Rooms</h3>
        <div class="row g-3">
            @if (Model != null && Model.Any())
            {
                foreach (var room in Model.Take(3))
                {
                    <div class="col-md-4">
                        <div class="card h-100 shadow-sm">

                            <!-- Room Images Carousel (Auto Slide Only) -->
                            <div id="carouselRoom@room.RoomId" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
                                <div class="carousel-inner">
                                    @{
                                        var imagesList = room.Images?.ToList() ?? new List<HotelDb.Models.RoomImage>();
                                        if (!imagesList.Any())
                                        {
                                            imagesList.Add(new HotelDb.Models.RoomImage { ImageUrl = "~/images/room-sample.jpg" });
                                        }
                                    }
                                    @for (int i = 0; i < imagesList.Count; i++)
                                    {
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <img src="@imagesList[i].ImageUrl"
                                                 class="d-block w-100"
                                                 style="height: 220px; object-fit: cover;"
                                                 alt="@room.Type" />
                                        </div>
                                    }
                                </div>
                            </div>

                            <div class="card-body">
                                <h5 class="card-title">@room.Type Room</h5>
                                <p class="card-text">Room № @room.Number</p>
                                <p><strong>₴@room.Price / night</strong></p>
                                <a href="@Url.Action("Details", "Rooms", new { id = room.RoomId })" class="btn btn-dark">View Details</a>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-center">No rooms available.</p>
            }
        </div>
        <div class="text-center mt-2">
            <a href="/Rooms" class="btn btn-outline-dark">View All Rooms</a>
        </div>
    </section>



    <!-- Our Services -->
    <section id="services" class="mb-5">
        <h3 class="fw-bold text-center mb-4" style="font-family: 'Playfair Display', serif;">Our Services</h3>
        <div class="row text-center g-4">

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <img src="~/images/services/service-spa.jpg" alt="Spa & Wellness"
                         class="card-img-top rounded-top"
                         style="height: 220px; object-fit: cover;" />
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Spa & Wellness</h5>
                        <p class="text-muted">Relax and rejuvenate with our luxury spa treatments, sauna, and wellness center.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <img src="~/images/services/service-dining.jpg" alt="Fine Dining"
                         class="card-img-top rounded-top"
                         style="height: 220px; object-fit: cover;" />
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Fine Dining</h5>
                        <p class="text-muted">Experience exquisite international cuisine crafted by our top chefs.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <img src="~/images/services/service-conference.jpg" alt="Conference Halls"
                         class="card-img-top rounded-top"
                         style="height: 220px; object-fit: cover;" />
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Conference Halls</h5>
                        <p class="text-muted">Host successful events and meetings in our modern, fully equipped halls.</p>
                    </div>
                </div>
            </div>

        </div>
    </section>
</div>
