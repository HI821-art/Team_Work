@model HotelApp.Models.AboutViewModel

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="fw-bold" style="font-family: 'Playfair Display', serif;">About Us</h1>
        <p class="text-muted fs-5">
            Welcome to <strong>Presidential Hotel</strong> – a place where timeless elegance meets modern comfort.
        </p>
    </div>

    <div class="row g-5">
        <div class="col-md-6">
            <h3 class="fw-bold mb-3">Our Story</h3>
            <p class="text-muted">
                Founded in 1998, our hotel has been a symbol of hospitality and sophistication for more than two decades.
                What started as a small family-owned residence has grown into one of the most renowned destinations
                for travelers seeking comfort, elegance, and unforgettable experiences.
            </p>
            <p class="text-muted">
                Over the years, we have welcomed thousands of guests from all around the world,
                building lasting relationships and unforgettable memories.
            </p>
        </div>
        <div class="col-md-6">
            <h3 class="fw-bold mb-3">Our Mission</h3>
            <p class="text-muted">
                We aim to provide each guest with not only accommodation, but also a holistic experience
                of warmth, care, and impeccable service.
            </p>
            <ul class="list-unstyled">
                <li class="mb-2">✔ Exceptional guest service</li>
                <li class="mb-2">✔ Unique and elegant rooms</li>
                <li class="mb-2">✔ A blend of tradition and innovation</li>
                <li class="mb-2">✔ Personalized experiences</li>
            </ul>
        </div>
    </div>

    <div class="row g-5 mt-5">
        <div class="col-md-6">
            <img src="~/images/about/history.jpg" class="img-fluid rounded shadow" alt="Hotel History" />
        </div>
        <div class="col-md-6 d-flex flex-column justify-content-center">
            <h3 class="fw-bold mb-3">A Place with a Soul</h3>
            <p class="text-muted">
                Every detail of our hotel tells a story – from the architecture inspired by
                classic European design, to the modern amenities that ensure maximum comfort.
            </p>
            <p class="text-muted">
                Our spaces are designed for relaxation, inspiration, and unforgettable moments,
                whether you are here for a short stay or a long vacation.
            </p>
        </div>
    </div>

    <div class="text-center mt-5">
        <h3 class="fw-bold mb-4">Our Team</h3>
        <p class="text-muted mb-4">
            Behind every successful stay is a dedicated team of professionals committed to excellence.
        </p>
        <div class="row justify-content-center g-4">
            <div class="col-md-3">
                <div class="card shadow border-0 h-100">
                    <img src="~/images/team/manager.jpg" class="card-img-top" style="height:300px;" alt="Manager">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Vlad Tymoshchuk</h5>
                        <p class="card-text text-muted">General Manager</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow border-0 h-100">
                    <img src="~/images/team/chef.jpg" class="card-img-top" style="height:300px;" alt="Chef">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Yevhen Klopotenko</h5>
                        <p class="card-text text-muted">Head Chef</p>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card shadow border-0 h-100">
                    <img src="~/images/team/reception.jpg" class="card-img-top" style="height:300px;" alt="Receptionist">
                    <div class="card-body">
                        <h5 class="card-title fw-bold">Mykola Tyshchenko</h5>
                        <p class="card-text text-muted">Front Desk Supervisor & Сall Сentre Supervisor</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-5">
        <h3 class="fw-bold mb-3">Why Choose Us?</h3>
        <p class="text-muted fs-5">
            Because at <strong>Presidential Hotel</strong>, every guest is treated like family.
            We combine luxury, comfort, and tradition to create unforgettable stays.
        </p>
    </div>
</div>