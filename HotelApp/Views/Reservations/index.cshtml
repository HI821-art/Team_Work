@model IEnumerable<HotelDb.Models.Room>
@{
    ViewData["Title"] = "Room Selection - Secure Hotel Booking";
}

<div class="container-fluid bg-primary text-white py-4 mb-4">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1 class="display-5 mb-2">Select Your Perfect Room</h1>
                <p class="mb-0">Secure booking system with instant confirmation</p>
            </div>
            <div class="col-md-4 text-md-end">
                <span class="badge bg-success fs-6">
                    <i class="fas fa-shield-alt me-2"></i>SSL Secured Booking
                </span>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Rooms" asp-action="Index">Rooms</a></li>
            <li class="breadcrumb-item active" aria-current="page">Room Selection</li>
        </ol>
    </nav>

    <!-- Search Form -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="fas fa-search me-2"></i>Search Available Rooms</h5>
        </div>
        <div class="card-body">
            <form id="searchForm" class="row g-3">
                <div class="col-md-3">
                    <label for="checkIn" class="form-label">Check-in Date</label>
                    <input type="date" class="form-control" id="checkIn" name="checkIn" 
                           value="@ViewBag.CheckIn?.ToString("yyyy-MM-dd")" required>
                </div>
                <div class="col-md-3">
                    <label for="checkOut" class="form-label">Check-out Date</label>
                    <input type="date" class="form-control" id="checkOut" name="checkOut" 
                           value="@ViewBag.CheckOut?.ToString("yyyy-MM-dd")" required>
                </div>
                <div class="col-md-2">
                    <label for="guests" class="form-label">Guests</label>
                    <select class="form-select" id="guests" name="guests">
                        <option value="1" @(ViewBag.Guests == 1 ? "selected" : "")>1 Guest</option>
                        <option value="2" @(ViewBag.Guests == 2 ? "selected" : "")>2 Guests</option>
                        <option value="3" @(ViewBag.Guests == 3 ? "selected" : "")>3 Guests</option>
                        <option value="4" @(ViewBag.Guests == 4 ? "selected" : "")>4 Guests</option>
                        <option value="5" @(ViewBag.Guests == 5 ? "selected" : "")>5+ Guests</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="rooms" class="form-label">Rooms</label>
                    <select class="form-select" id="rooms" name="rooms">
                        <option value="1">1 Room</option>
                        <option value="2">2 Rooms</option>
                        <option value="3">3 Rooms</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">&nbsp;</label>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search me-2"></i>Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Loading Spinner -->
    <div id="loadingSpinner" class="text-center my-5" style="display: none;">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="mt-2">Searching for available rooms...</p>
    </div>

    <!-- Room Cards Container -->
    <div id="roomsContainer">
        @if (Model.Any())
        {
            <div class="row">
                <div class="col-12 mb-3">
                    <h4>Available Rooms (@ViewBag.TotalNights night@(ViewBag.TotalNights > 1 ? "s" : ""))</h4>
                    <small class="text-muted">
                        @ViewBag.CheckIn?.ToString("MMM dd, yyyy") - @ViewBag.CheckOut?.ToString("MMM dd, yyyy") 
                        • @ViewBag.Guests guest@(ViewBag.Guests > 1 ? "s" : "")
                    </small>
                </div>
            </div>
            @await Html.PartialAsync("_RoomCards", Model)
        }
        else
        {
            <div class="alert alert-warning">
                <i class="fas fa-exclamation-triangle me-2"></i>
                No rooms available for the selected dates and guest count. Please try different dates or contact us directly.
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
$(document).ready(function() {
    // Set minimum dates
    const today = new Date().toISOString().split('T')[0];
    $('#checkIn').attr('min', today);
    $('#checkOut').attr('min', today);

    // Auto-update checkout date when checkin changes
    $('#checkIn').on('change', function() {
        const checkIn = new Date(this.value);
        const nextDay = new Date(checkIn);
        nextDay.setDate(checkIn.getDate() + 1);
        const nextDayStr = nextDay.toISOString().split('T')[0];
        
        $('#checkOut').attr('min', nextDayStr);
        
        if ($('#checkOut').val() <= this.value) {
            $('#checkOut').val(nextDayStr);
        }
    });

    // Search form submission
    $('#searchForm').on('submit', function(e) {
        e.preventDefault();
        
        const formData = {
            checkIn: $('#checkIn').val(),
            checkOut: $('#checkOut').val(),
            guests: $('#guests').val()
        };

        // Validate dates
        if (new Date(formData.checkIn) >= new Date(formData.checkOut)) {
            alert('Check-out date must be after check-in date.');
            return;
        }

        // Show loading spinner
        $('#loadingSpinner').show();
        $('#roomsContainer').hide();

        // Make AJAX request
        $.get('@Url.Action("SearchRooms")', formData)
            .done(function(data) {
                $('#roomsContainer').html(data).show();
                $('#loadingSpinner').hide();
                
                // Update URL without page reload
                const newUrl = '@Url.Action("Index")' + 
                    '?checkIn=' + formData.checkIn + 
                    '&checkOut=' + formData.checkOut + 
                    '&guests=' + formData.guests;
                history.pushState(null, '', newUrl);
            })
            .fail(function() {
                $('#loadingSpinner').hide();
                $('#roomsContainer').show();
                alert('Error searching rooms. Please try again.');
            });
    });

    // Initialize tooltips
    var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
    var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
        return new bootstrap.Tooltip(tooltipTriggerEl);
    });
});

// Book room function
function bookRoom(roomId) {
    const checkIn = $('#checkIn').val();
    const checkOut = $('#checkOut').val();
    
    if (!checkIn || !checkOut) {
        alert('Please select your check-in and check-out dates first.');
        return;
    }
    
    // Redirect to booking form
    window.location.href = '@Url.Action("Create")' + 
        '?roomId=' + roomId + 
        '&checkIn=' + checkIn + 
        '&checkOut=' + checkOut;
}
</script>
}