@model HotelDb.Models.ReservationViewModel

@{
    ViewData["Title"] = "Room Booking";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="reservation-create-page">
    <div class="container py-4">
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">@Html.ActionLink("Home", "Index", "Home")</li>
                <li class="breadcrumb-item">@Html.ActionLink("Reservations", "Index", "Reservations")</li>
                <li class="breadcrumb-item active">Booking Details</li>
            </ol>
        </nav>

        <div class="row">
            <!-- Room Information -->
            <div class="col-lg-5 mb-4">
                <div class="card shadow-lg h-100">
                    <div class="room-images">
                        @if (Model.Room.Images != null && Model.Room.Images.Any())
                        {
                            <div id="roomCarousel" class="carousel slide" data-bs-ride="carousel">
                                <div class="carousel-inner">
                                    @for (int i = 0; i < Model.Room.Images.Count(); i++)
                                    {
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <img src="@Model.Room.Images.ElementAt(i).ImageUrl" class="d-block w-100 room-main-image" alt="Room Image">
                                        </div>
                                    }
                                </div>
                                @if (Model.Room.Images.Count() > 1)
                                {
                                    <button class="carousel-control-prev" type="button" data-bs-target="#roomCarousel" data-bs-slide="prev">
                                        <span class="carousel-control-prev-icon"></span>
                                    </button>
                                    <button class="carousel-control-next" type="button" data-bs-target="#roomCarousel" data-bs-slide="next">
                                        <span class="carousel-control-next-icon"></span>
                                    </button>
                                    <div class="carousel-indicators">
                                        @for (int i = 0; i < Model.Room.Images.Count(); i++)
                                        {
                                            <button type="button" data-bs-target="#roomCarousel" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"></button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="room-main-image bg-light d-flex align-items-center justify-content-center">
                                <i class="bi bi-house-door fs-1 text-muted"></i>
                            </div>
                        }
                    </div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h4 class="card-title mb-0">@Model.Room.Type</h4>
                            <span class="badge bg-primary fs-6">No.@Model.Room.Number</span>
                        </div>

                        <div class="room-info mb-3">
                            <p class="mb-2"><i class="bi bi-people-fill text-primary me-2"></i>Up to @Model.Room.Capacity guests</p>
                            <p class="mb-2"><i class="bi bi-currency-dollar text-primary me-2"></i>₴@Model.Room.Price.ToString("N0") per night</p>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Room.Description))
                        {
                            <p class="text-muted mb-3">@Model.Room.Description</p>
                        }

                        @if (!string.IsNullOrEmpty(Model.Room.Amenities))
                        {
                            <div class="amenities mb-4">
                                <h6><i class="bi bi-star-fill text-warning me-1"></i>Amenities:</h6>
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var amenity in Model.Room.Amenities.Split(','))
                                    {
                                        <span class="badge bg-light text-dark border">@amenity.Trim()</span>
                                    }
                                </div>
                            </div>
                        }

                        <div class="price-summary bg-light p-3 rounded">
                            <div class="d-flex justify-content-between mb-2">
                                <span>₴@Model.Room.Price.ToString("N0") × <span id="nightsCount">@((Model.CheckOut - Model.CheckIn).Days)</span> nights</span>
                                <span id="subtotal">₴@Model.TotalPrice.ToString("N0")</span>
                            </div>
                            <hr class="my-2">
                            <div class="d-flex justify-content-between">
                                <strong>Total:</strong>
                                <strong class="text-primary" id="totalPrice">₴@Model.TotalPrice.ToString("N0")</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Booking Form -->
            <div class="col-lg-7">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><i class="bi bi-calendar-check me-2"></i>Booking Form</h5>
                    </div>
                    <div class="card-body p-4">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <h6><i class="bi bi-exclamation-triangle-fill me-2"></i>Form Errors:</h6>
                                @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                            </div>
                        }

                        @using (Html.BeginForm("Book", "Reservations", FormMethod.Post, new { @class = "needs-validation", @novalidate = "novalidate" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.HiddenFor(m => m.RoomId)

                            <div class="mb-4">
                                <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-calendar-range me-2"></i>Stay Dates</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        @Html.LabelFor(m => m.CheckIn, "Check-in", new { @class = "form-label" })
                                        @Html.EditorFor(m => m.CheckIn, new { htmlAttributes = new { @class = "form-control", @id = "checkInDate" } })
                                        @Html.ValidationMessageFor(m => m.CheckIn, "", new { @class = "invalid-feedback d-block" })
                                    </div>
                                    <div class="col-md-6">
                                        @Html.LabelFor(m => m.CheckOut, "Check-out", new { @class = "form-label" })
                                        @Html.EditorFor(m => m.CheckOut, new { htmlAttributes = new { @class = "form-control", @id = "checkOutDate" } })
                                        @Html.ValidationMessageFor(m => m.CheckOut, "", new { @class = "invalid-feedback d-block" })
                                    </div>
                                </div>
                                <div class="mt-2">
                                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Check-in after 14:00, check-out before 12:00</small>
                                </div>
                            </div>

                            <div class="mb-4">
                                <h6 class="border-bottom pb-2 mb-3"><i class="bi bi-person-fill me-2"></i>Guest Information</h6>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        @Html.LabelFor(m => m.FullName, "Full Name", new { @class = "form-label" })
                                        @Html.EditorFor(m => m.FullName, new { htmlAttributes = new { @class = "form-control", @placeholder = "First and Last Name" } })
                                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "invalid-feedback d-block" })
                                    </div>
                                    <div class="col-md-6">
                                        @Html.LabelFor(m => m.Email, "Email", new { @class = "form-label" })
                                        @Html.EditorFor(m => m.Email, new { htmlAttributes = new { @class = "form-control", @type = "email", @placeholder = "example@email.com" } })
                                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "invalid-feedback d-block" })
                                    </div>
                                    <div class="col-md-6">
                                        @Html.LabelFor(m => m.Phone, "Phone", new { @class = "form-label" })
                                        @Html.EditorFor(m => m.Phone, new { htmlAttributes = new { @class = "form-control", @placeholder = "+380..." } })
                                        @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "invalid-feedback d-block" })
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="acceptTerms" required>
                                    <label class="form-check-label" for="acceptTerms">
                                        I agree to the <a href="#" data-bs-toggle="modal" data-bs-target="#termsModal">booking terms</a> and <a href="#">privacy policy</a>
                                    </label>
                                    <div class="invalid-feedback">You must agree to the terms</div>
                                </div>
                            </div>

                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-primary btn-lg">
                                    <i class="bi bi-credit-card me-2"></i>Confirm Booking
                                </button>
                                @Html.ActionLink("Back to Search", "Index", "Reservations", new { checkIn = Model.CheckIn.ToString("yyyy-MM-dd"), checkOut = Model.CheckOut.ToString("yyyy-MM-dd") }, new { @class = "btn btn-outline-secondary" })
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Terms Modal -->
<div class="modal fade" id="termsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Booking Terms</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6>Cancellation Policy</h6>
                <ul>
                    <li>Free cancellation up to 24 hours before check-in</li>
                    <li>50% fee if cancelled within 24 hours</li>
                    <li>100% fee for no-show</li>
                </ul>
                <h6>House Rules</h6>
                <ul>
                    <li>Check-in: after 14:00</li>
                    <li>Check-out: before 12:00</li>
                    <li>No smoking in rooms</li>
                    <li>No pets allowed</li>
                </ul>
                <h6>Payment</h6>
                <ul>
                    <li>Full payment at check-in</li>
                    <li>Cash and card accepted</li>
                    <li>Deposit of ₴500 for potential damages</li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Understood</button>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const roomId = @Model.RoomId;
        const checkInInput = document.getElementById('checkInDate');
        const checkOutInput = document.getElementById('checkOutDate');

        fetch(`/Reservations/BookedDates?roomId=${roomId}`)
            .then(res => res.json())
            .then(data => {
                const disabledRanges = data.map(d => ({
                    from: d.checkIn,
                    to: d.checkOut
                }));

                const checkOutInstance = flatpickr(checkOutInput, {
                    dateFormat: "Y-m-d",
                    minDate: new Date(Date.now() + 24*60*60*1000),
                    disable: disabledRanges
                });

                flatpickr(checkInInput, {
                    dateFormat: "Y-m-d",
                    minDate: "today",
                    disable: disabledRanges,
                    onChange: function(selectedDates) {
                        if(selectedDates[0]) {
                            const minCheckout = new Date(selectedDates[0].getTime() + 24*60*60*1000);
                            checkOutInstance.set('minDate', minCheckout);
                            if(new Date(checkOutInput.value) <= minCheckout){
                                checkOutInput.value = minCheckout.toISOString().split('T')[0];
                            }
                        }
                    }
                });
            });
    });
</script>
