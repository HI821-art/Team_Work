@model HotelDb.Models.RoomViewModel

@{
    ViewData["Title"] = "Create Room";
    Layout = "_Layout";
}

<section class="form-section py-4">
    <div class="container">
        <h1 class="text-center mb-4 fw-bold text-white">Create Room</h1>
        <div class="row">
            <div class="col-md-5 mx-auto">
                <div class="card bg-dark text-white shadow-lg rounded-4 p-4">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        @await Html.PartialAsync("_RoomForm", Model)
                        <div class="form-group text-center">
                            <input type="submit" value="Create" class="btn btn-primary" />
                        </div>
                    </form>
                </div>
            </div>
        </div>
        <div class="text-center mt-3">
            <a class="btn btn-outline-light" asp-action="Index">Back to List</a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('.image-url-input').forEach(input => {
            input.addEventListener('input', function () {
                const previewId = this.dataset.previewId;
                const previewImg = document.getElementById(previewId);
                if (this.value.trim()) {
                    previewImg.src = this.value;
                    previewImg.style.display = 'block';
                } else {
                    previewImg.src = '';
                    previewImg.style.display = 'none';
                }
            });
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}