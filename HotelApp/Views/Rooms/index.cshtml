@model IEnumerable<HotelDb.Models.Room>

@{
    ViewData["Title"] = "Rooms";
    Layout = "_Layout";
    var selectedType = Context.Request.Query["type"].ToString();
}

<section class="rooms-section py-4">
    <div class="container">
        <h2 class="text-center mb-4 fw-bold text-dark">Our Rooms</h2>

        <!--  нопки Filter та Create New Room -->
        <div class="d-flex justify-content-between mb-3 align-items-start">
            <!-- Filter панель -->
            <div class="container mb-3 p-0">
                <button class="btn btn-outline-primary mb-3" id="filterBtn">
                    <i class="bi bi-funnel"></i> Filter
                </button>

                <div class="filter-panel bg-light p-4 rounded-3 shadow-sm">
                    <form class="row g-3">
                        <!-- Min Price -->
                        <div class="col-md-3">
                            <label class="form-label">Min Price</label>
                            <input type="number" name="minPrice" class="form-control" value="@Context.Request.Query["minPrice"]" />
                        </div>

                        <!-- Max Price -->
                        <div class="col-md-3">
                            <label class="form-label">Max Price</label>
                            <input type="number" name="maxPrice" class="form-control" value="@Context.Request.Query["maxPrice"]" />
                        </div>

                        <!-- Guests -->
                        <div class="col-md-3">
                            <label class="form-label">Guests</label>
                            <input type="number" name="capacity" class="form-control" value="@Context.Request.Query["capacity"]" />
                        </div>

                        <!-- Room Type -->
                        <div class="col-md-3">
                            <label class="form-label">Room Type</label>
                            <select name="type" class="form-select">
                                <option value="" selected="@(string.IsNullOrEmpty(selectedType))">Any</option>
                                <option value="Deluxe" selected="@(selectedType == "Deluxe")">Deluxe</option>
                                <option value="Executive" selected="@(selectedType == "Executive")">Executive</option>
                                <option value="Presidential" selected="@(selectedType == "Presidential")">Presidential</option>
                            </select>
                        </div>

                        <!--  нопки Apply / Reset -->
                        <div class="col-12 d-flex gap-2 mt-3">
                            <button type="submit" class="btn btn-primary w-100">Apply</button>
                            <a href="#" class="btn btn-secondary w-100" id="resetBtn">Reset</a>
                        </div>
                    </form>
                </div>
            </div>
            
            <!-- Create New Room -->
            @if (User.IsInRole("Admin"))
            {
				<a asp-action="Create" class="btn btn-primary" style="width:180px;">Create New Room</a>
			}
        </div>

        <!-- —писок к≥мнат -->
        <div class="row" id="roomsContainer">
            @await Html.PartialAsync("_RoomCards", Model)
        </div>
    </div>
</section>

@section Scripts {
    <script>
        const filterBtn = document.getElementById('filterBtn');
        const filterPanel = document.querySelector('.filter-panel');
        const applyBtn = document.querySelector('form button[type="submit"]');
        const resetBtn = document.getElementById('resetBtn');
        const roomsContainer = document.getElementById('roomsContainer');

        // Toggle панель
        filterBtn.addEventListener('click', () => {
            filterPanel.classList.toggle('show');
        });

        // Apply filter
        applyBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            const form = e.target.closest('form');
            const formData = new FormData(form);
            const query = new URLSearchParams(formData).toString();
            const response = await fetch(`/Rooms/Filter?${query}`);
            const html = await response.text();
            roomsContainer.innerHTML = html;
        });

        // Reset filter
        resetBtn.addEventListener('click', async (e) => {
            e.preventDefault();
            const response = await fetch(`/Rooms/Filter`);
            const html = await response.text();
            roomsContainer.innerHTML = html;
            document.querySelectorAll('form input, form select').forEach(i => i.value = '');
        });
    </script>
}
