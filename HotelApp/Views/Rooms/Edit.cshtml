@model HotelDb.Models.RoomViewModel

@{
    ViewData["Title"] = "Edit Room";
    Layout = "_Layout";
}

<section class="form-section">
    <div class="container">
        <h1 class="text-center mb-4">Edit Room</h1>
        <hr />
        <div class="row">
            <div class="col-md-4 mx-auto">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="RoomId" />
                    @await Html.PartialAsync("_RoomForm", Model)
                    <div class="form-group text-center">
                        <button type="submit" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </div>
        <div class="text-center mt-3">
            <a class="btn btn-dark" asp-action="Index">Back to List</a>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll('.image-url-input').forEach(input => {
            input.addEventListener('input', function () {
                const previewId = this.dataset.previewId;
                const previewImg = document.getElementById(previewId);
                if (this.value.trim()) {
                    previewImg.src = this.value;
                    previewImg.style.display = 'block';
                } else {
                    previewImg.src = '';
                    previewImg.style.display = 'none';
                }
            });
        });
    </script>

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}