@model HotelDb.Models.RoomViewModel
@{
    ViewData["Title"] = "Edit Room";
    Layout = "_Layout";
}

<section class="form-section">
    <div class="container">
        <h1 class="text-center mb-4">Edit Room</h1>
        <hr />

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row">
            <div class="col-lg-10 mx-auto">
                <!-- Increased width for better layout -->
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="RoomId" />

                    @await Html.PartialAsync("_RoomForm", Model)

                    <div class="form-group text-center mt-4">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-save me-2"></i>Save Changes
                        </button>
                        <a class="btn btn-secondary btn-lg ms-3" asp-action="Index">
                            <i class="bi bi-arrow-left me-2"></i>Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- Only include scripts that don't conflict with the partial's JavaScript -->
    <script>
        // Global function for amenities (called from partial)
        window.updateAmenitiesField = function() {
            const checkboxes = document.querySelectorAll('.form-check-input[type="checkbox"]');
            const selected = Array.from(checkboxes)
                .filter(cb => cb.checked)
                .map(cb => cb.value.trim());
            const hiddenField = document.getElementById('AmenitiesField');
            if (hiddenField) {
                hiddenField.value = selected.join(', ');
            }
        };

               document.querySelectorAll('.image-url-input').forEach(input => {
            input.addEventListener('input', function () {
                const previewId = this.dataset.previewId;
                const previewImg = document.getElementById(previewId);
                if (this.value.trim()) {
                    previewImg.src = this.value;
                    previewImg.style.display = 'block';
                } else {
                    previewImg.src = '';
                    previewImg.style.display = 'none';
                }
            });
        });


        // Auto-dismiss success message after 5 seconds
        setTimeout(function() {
            const alert = document.querySelector('.alert-success');
            if (alert) {
                alert.classList.remove('show');
                setTimeout(() => alert.remove(), 150);
            }
        }, 5000);
    </script>
}