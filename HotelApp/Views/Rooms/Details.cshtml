@model HotelDb.Models.Room
@using System.Linq

@{
    ViewData["Title"] = "Room Details";
    Layout = "_Layout";
}

<section class="details-section py-4">
    <div class="container">
        <h1 class="text-center mb-4 fw-bold" style="font-family: 'Playfair Display', serif;">Room Details</h1>

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="card shadow rounded">
                    @* ќсновне фото (використовуЇмо перше з Images або placeholder) *@
                    @{
                        var mainImage = Model.Images?.FirstOrDefault()?.ImageUrl ?? "/images/rooms/placeholder-room.jpg";
                        var altText = $"Room {Model.Number}";
                    }
                    <img id="mainRoomImage" src="@mainImage" class="card-img-top img-fluid" alt="@altText"
                         style="object-fit: cover; max-height: 650px; width:100%;" />

                    <div class="card-body bg-dark text-white">
                        <h4 class="card-title mb-2">@Model.Number &nbsp; Ч &nbsp; @Model.Type</h4>

                        <h4 class="card-title mb-2"></h4>

                        <p class="card-text">@Model.Description</p>

                        @if (!string.IsNullOrEmpty(Model.Amenities))
                        {
                            <div class="mt-3">
                                <h6 class="fw-bold">Amenities:</h6>
                                <div class="row">
                                    @foreach (var amenity in Model.Amenities.Split(',', System.StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <div class="col-6 mb-2 d-flex align-items-start">
                                            <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                                            <span class="card-text">@amenity.Trim()</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <h4 class="card-title mb-2"></h4>

                        <dl class="row">
                            <dt class="col-sm-5">Price</dt>
                            <dd class="col-sm-7">@($"{Model.Price:N0} UAH / night")</dd>

                            <dt class="col-sm-5">Status</dt>
                            <dd class="col-sm-7">@(Model.Status == "Free" ? "Available" : "Booked")</dd>

                            <dt class="col-sm-5">Capacity</dt>
                            <dd class="col-sm-7">@($"{Model.Capacity} {(Model.Capacity == 1 ? "person" : "people")}")</dd>
                        </dl>

                        <div class="text-center mt-3">
                            <a href="/Reservations" class="btn book-now-btn">Book Now</a>
                            @if (User.IsInRole("Admin"))
                            {
                            <a asp-action="Edit" asp-route-id="@Model.RoomId" class="btn btn-warning">Edit</a>
								<a asp-action="Delete" asp-route-id="@Model.RoomId" class="btn btn-danger mx-2">Delete</a>
                            }
                            <a asp-action="Index" class="btn btn-outline-light">Back to List</a>
                        </div>
                    </div>
                </div>

                @* Thumbnails (€кщо Ї б≥льше 1 фото) *@
                @if (Model.Images != null && Model.Images.Count > 1)
                {
                    <div class="mt-3 d-flex gap-2 justify-content-center flex-wrap">
                        @foreach (var im in Model.Images)
                        {
                            <img src="@im.ImageUrl"
                                 class="rounded shadow-sm"
                                 style="width:120px; height:80px; object-fit:cover; cursor:pointer; border:2px solid transparent;"
                                 onclick="document.getElementById('mainRoomImage').src='@im.ImageUrl';"
                                 onmouseover="this.style.borderColor='rgba(255,255,255,0.6)';"
                                 onmouseout="this.style.borderColor='transparent';"
                                 alt="Thumbnail" />
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

    <style>
    .book-now-btn {
        margin-right: 10px;
        background: linear-gradient(135deg, #c9a14d 0%, #a5823d 100%);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        animation: pulse 2s infinite; /* пульсац≥€ */
    }

        .book-now-btn:hover {
            background: linear-gradient(135deg, #a5823d 0%, #c9a14d 100%);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.25);
            color: #fff;
        }

    @@keyframes pulse {
        0%

    {
        transform: scale(1);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

    50% {
        transform: scale(1.05);
        box-shadow: 0 6px 20px rgba(201, 161, 77, 0.6);
    }

    100% {
        transform: scale(1);
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    }

    }

    </style >